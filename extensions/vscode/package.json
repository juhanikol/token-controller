{
  "name": "token-controller-ui",
  "displayName": "token-controller-ui",
  "description": "UI for AI Context Workflow Controller",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "publisher": "juhanikolehmainen",
  "author": {
    "name": "Juhani Kolehmainen"
  },
  "license": "MIT",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The extension runs the Token Controller CLI from the path in your user settings. It never uses a path from workspace settings. In an untrusted workspace it does not run a controller that is inside that workspace. A controller outside the workspace still runs.",
      "restrictedConfigurations": [
        "tokenController.scriptPath"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juhanikol/token-controller"
  },
  "bugs": {
    "url": "https://github.com/juhanikol/token-controller/issues"
  },
  "contributes": {
    "commands": [
      {
        "command": "tokenController.selectMode",
        "title": "AI Context: Switch Mode"
      },
      {
        "command": "tokenController.showLeanctxStatus",
        "title": "Token Controller: Show LeanCTX Status"
      }
    ],
    "configuration": {
      "title": "Token Controller",
      "properties": {
        "tokenController.scriptPath": {
          "type": "string",
          "default": "~/projects/token-controller/scripts/workflow.sh",
          "description": "Absolute path (or ~/...) to workflow.sh. The extension runs workflow-cli.sh from the same folder. Set it in user or remote machine settings. Workspace settings are ignored. The file must be named workflow.sh.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
