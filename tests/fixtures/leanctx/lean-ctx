#!/usr/bin/env bash
# Fake lean-ctx for tests/leanctx.test.sh. Deterministic. It logs every call to $FAKE_LC_LOG (one line per call).
# FAKE_LC_FULL=lossy: a full read returns headings and a triage note, not the file (the D-39 behavior of the real CLI).
# FAKE_LC_GREP=empty: grep returns only notes, no matches (the D-39 false negative). FAKE_LC_GREP=fail: exit 3. FAKE_LC_GREP=literal: fixed-string search (accepts patterns that POSIX ERE rejects).
# It supports only: --version, status, doctor, read <file> [-m mode] [--fresh], grep <pattern> <path>, ls <path>.
# wrap, setup, init, onboard, -c, and anything else: logged, then exit 9. It never writes anything except the log.
printf '%s\n' "$*" >> "${FAKE_LC_LOG:-/dev/null}"
case "${1:-}" in
  --version) echo "lean-ctx 9.9.9 (fake)" ;;
  status)
    echo "lean-ctx status  v9.9.9"
    echo "  shadow_mode: active"
    echo "  doctor: 2/2" ;;
  doctor)
    echo "lean-ctx doctor  diagnostics"
    echo "  ✓  lean-ctx in PATH"
    echo "  ✓  data dir  exists" ;;
  read)
    file="${2:-}"; mode=full
    shift 2 2>/dev/null
    while [ $# -gt 0 ]; do
      case "$1" in -m) mode="${2:-full}"; shift ;; esac
      shift
    done
    if [ ! -f "$file" ]; then
      echo "lean-ctx: cannot read $file: no such file" >&2
      exit 2
    fi
    case "$mode" in
      signatures|map|task|reference|auto) grep '^#' "$file" ;;
      *)
        if [ "${FAKE_LC_FULL:-}" = lossy ]; then
          grep '^#' "$file"
          echo "[lean-ctx: $(wc -l < "$file" | tr -d ' ') lines filtered by triage (level 2)]"
        else
          cat "$file"
        fi ;;
    esac ;;
  grep)
    shift
    case "${FAKE_LC_GREP:-}" in
      empty) echo "(81 files skipped: binary/encoding)"; echo "[lean-ctx: 22 lines filtered by triage (level 2)]" ;;
      fail) echo "fake lean-ctx: grep failed" >&2; exit 3 ;;
      literal) command grep -rnF -- "$@" ;;
      *) command grep -rnE -- "$@" ;;
    esac ;;
  ls)
    shift
    command ls -1 -- "$@" ;;
  *)
    echo "fake lean-ctx: not supported: $*" >&2
    exit 9 ;;
esac
