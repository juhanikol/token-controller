  "command_policy": {
    "noisy_success_can_compress": [
      "npm install",
      "pnpm install",
      "yarn install",
      "docker build",
      "dotnet restore",
      "cargo fetch",
      "pip install"
    ],
    "preserve_raw_or_lossless": [
      "npm audit",
      "govulncheck",
      "trivy",
      "grype",
      "snyk",
      "semgrep",
      "gitleaks",
      "flyway",
      "liquibase",
      "prisma migrate",
      "mysql",
      "psql"
    ],
    "test_commands": [
      "pytest",
      "go test",
      "npm test",
      "dotnet test",
      "cargo test"
    ]
